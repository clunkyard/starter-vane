# Higher-priority rules take over one control at a time.
# Clunkyard guide: https://clunkyard.com/sdk/vane
bot My robot
modes 2d 3d
rulesets classic inertial-2d gravity-flat gravity-hills zero-g

# Power and elevation for a shot that travels for about one second.
let shot-power = clamp((range - shot-speed-base) / shot-speed-per-power, power-min, power-max)
let shot-elevation = elevation - gravity-z * 28.6 / max(range, shot-speed-base + shot-speed-per-power * power-max)

# Leave the storm at right angles to its drift, on our side of its path.
let exit-heading = storm-heading + 90 - 180 * (angle(storm-bearing, storm-heading) > 0)

# Return to the safe zone while letting the turret track.
rule home priority 300 when zone-active and zone-distance > zone-radius - 60
  turn clamp(angle(zone-bearing, heading) / 30, -1, 1)
  pitch clamp((zone-elevation - pitch) / 30, -1, 1)
  drive 0.8
  yaw-torque clamp(angle(zone-bearing, heading) / 70 - yaw-rate / 60, -1, 1)
  thrust 0.6
  lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 + sin(zone-elevation) - vz / 50, -1, 1)
end

# Turn across the storm's path while the turret tracks.
rule storm priority 250 when storm-distance < 60
  turn clamp(angle(exit-heading, heading) / 30, -1, 1)
  pitch clamp(-pitch / 45, -1, 1)
  drive 1
  yaw-torque clamp(angle(exit-heading, heading) / 70 - yaw-rate / 60, -1, 1)
  thrust 0.8
end

# Swerve for half a second after hearing a shot. The cue age remembers when it was heard.
rule dodge priority 225 when muzzle-heard or (cue-muzzle and cue-age < 10)
  drive 1 - 0.5 * (battery-fraction < 0.25)
  turn 1 - 2 * ((tick - cue-age * (not muzzle-heard)) % 2 == 0)
  thrust 0.5 - 0.25 * (battery-fraction < 0.25)
  strafe 2 * ((tick - cue-age * (not muzzle-heard)) % 2 == 0) - 1
end

# In force-based matches, hover at 60 units and damp the hull's spin.
rule fly priority 200 when physics-mode
  lift clamp(-gravity-z / 100 + gravity * (60 - altitude) / 100 - vz / 50, -1, 1)
  pitch-torque clamp(-pitch / 40 - pitch-rate / 60, -1, 1)
  roll-torque clamp(-roll-rate / 60, -1, 1)
  # With no contact, turn toward a cue, or keep turning to search.
  yaw-torque clamp(angle(bearing, heading) / 70 + (not contact) * (cue-present * angle(cue-bearing, heading) / 70 + 0.2 * (not cue-present)) - yaw-rate / 60, -1, 1)
  thrust clamp((range - 200) / 180, -0.5, 0.6) * (1 - 0.5 * (battery-fraction < 0.25))
  brake speed > 70
end

rule track priority 100 when contact
  # Circle the target to keep moving across its line of fire.
  turn clamp(angle(bearing + 90 + wave(50, 30), heading) / 45, -1, 1)
  pitch clamp(-pitch / 45, -1, 1)
  drive 0.5 - 0.25 * (battery-fraction < 0.25)
  aim-heading bearing
  # Aim higher to account for gravity.
  aim-pitch shot-elevation
  scan-heading bearing
  scan-pitch elevation
  # Narrow the beam for a better bearing. Widen it every 40 ticks to look for closer robots.
  scan-arc 40 * (tick % 40 == 0) + (tick % 40 != 0) * min(40, max(6, 2 * atan2(30, range), scan-arc / 2))
  # Choose the heaviest shot that can travel the range in about one second.
  power shot-power
  # Wait for the turret and a precise bearing, then leave 10 battery in reserve.
  fire cooldown == 0 and abs(aim-error) < 3 and range * bearing-error / 57.3 < 12 and abs(shot-elevation - aim-pitch) < 3 and battery >= shot-cost-base + shot-cost-per-power * shot-power + 10
end

# Use a passive cue to aim the scanner.
rule listen priority 20 when cue-present and not contact
  drive 0.6 - 0.3 * (battery-fraction < 0.25)
  turn clamp(angle(cue-bearing, heading) / 45, -1, 1)
  pitch clamp(-pitch / 45, -1, 1)
  scan-heading cue-bearing + wave(14, cue-error + 10)
  scan-pitch cue-elevation
  scan-arc 30
end

rule search priority 10 when true
  drive 0.6 - 0.3 * (battery-fraction < 0.25)
  turn 0.25
  pitch clamp(-pitch / 45, -1, 1)
  # Sweep a medium-width beam past every heading in ten ticks.
  scan-heading scan-heading + 36
  # Nod the scanner up and down to find 3D targets above or below.
  scan-pitch wave(31, 25)
  scan-arc 40
end
